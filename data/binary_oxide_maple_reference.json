{
  "_metadata": {
    "title": "Binary Oxide MAPLE Reference Table",
    "description": "Reference MAPLE (Madelung Part of Lattice Energy) values for binary oxides, for use with Hoppe's additivity theorem. Values are in kcal/mol per formula unit.",
    "version": "1.3.0",
    "authors": [
      "Peter Gross",
      "Nik Reeves-McLaren"
    ],
    "associated_paper": "Database-Scale Validation of Hoppe's MAPLE Additivity Theorem for Perovskite and Pyrochlore Oxides",
    "tool": "MaplePy",
    "units": {
      "maple_kcal_mol": "kcal/mol per formula unit",
      "maple_kj_mol": "Not included; multiply kcal/mol by 4.184 to convert"
    },
    "methodology": {
      "icsd_calibrated": "Median MAPLE across qualifying ICSD entries at ambient conditions (273-303 K, <0.15 MPa). High-pressure entries, zero-MAPLE entries, and non-stoichiometric compositions excluded.",
      "validation": "Recorded as a MaplePy validation calculation. The one entry so marked, Cu2O, does not reproduce (MaplePy gives 797.9 kcal/mol at a = 4.270 A) and is marked sourced: false.",
      "estimated": "Interpolated from chemical trends within structure type families (e.g., lanthanide contraction in bixbyite RE2O3 series), or set by hand. These have no published or computed source (sourced: false), carry additional uncertainty, and should be replaced when a source becomes available. Hopper 1.2.9 and later report every decomposition that uses one."
    },
    "source_classifications": {
      "icsd_median": "Calibrated from ICSD median (93 of 109, 85%)",
      "estimated": "Estimated, with no ICSD calibration (15 of 109, 14%): Ni2O3 and Co2O3 are isostructural corundum estimates with a stated uncertainty; the other 13 were set by hand and enter no decomposition reported in the associated paper",
      "validation": "From a MaplePy validation structure (1 of 109); does not reproduce, so unsourced"
    },
    "n_entries": 109,
    "licence": "CC-BY-4.0",
    "citation": "Reeves-McLaren, N.; Gross, P. Database-Scale Validation of Hoppe's MAPLE Additivity Theorem for Perovskite and Pyrochlore Oxides. J. Appl. Cryst., under review (2026).",
    "metadata_note": "v1.3.0 (ui5052 revision): Bi2O3, PbO, HgO, TcO2 and Tl2O calibrated from ambient ICSD entries; Ni2O3 re-estimated and Co2O3 added by isostructural scaling of six calibrated corundum sesquioxides by the ratio of cation-oxygen radius sums, using Shannon radii for low-spin Ni3+ (0.56 A) and Co3+ (0.545 A); Bi2O5, Ru2O5, RuO3 and Re2O5 removed because no ambient binary oxide of those oxidation states exists. n_entries and source_classifications are computed from the entries list. Earlier history: v1.1.1 added the sourced flag and review notes; values were unchanged from v1.0.0 to v1.1.1.",
    "ui5052_R1_rev2": "Bi2O3, PbO, HgO, TcO2 and Tl2O calibrated from ambient ICSD entries (medians). Bi2O5, Ru2O5, RuO3 and Re2O5 removed: no ambient binary oxide of Bi(V), Ru(V), Ru(VI) or Re(V) exists, so structures that need one are classified 1.3, as Os2O5, Tc2O5 and Ir2O5 already were."
  },
  "_field_descriptions": {
    "formula": "Reduced chemical formula of the binary oxide",
    "maple_kcal_mol": "MAPLE value in kcal/mol per formula unit",
    "structure_type": "Crystal structure type and space group",
    "source": "How the value was determined: ICSD median, validation, or estimated",
    "n_icsd_entries": "Number of qualifying ICSD entries used for the median (null if estimated)",
    "icsd_range_min": "Minimum MAPLE across qualifying ICSD entries (null if estimated)",
    "icsd_range_max": "Maximum MAPLE across qualifying ICSD entries (null if estimated)",
    "confidence": "high = ICSD median from >= 10 entries; medium = ICSD median from 2-9 entries; low = estimated, a single entry, or a source that does not reproduce",
    "sourced": "false where the value has no published or computed source, or where its recorded source does not reproduce",
    "review_note": "Present where the entry needs re-deriving; states why"
  },
